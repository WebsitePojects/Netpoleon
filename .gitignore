# --- Secrets: NO env file is ever tracked, placeholders included. ---
# Glob on purpose: a list of names always misses the next variant.
# Variable NAMES are documented in docs/ (prose), never in a committed env file.
.env*
*.pem
*.key
*.p12
*.pfx
secrets/

# --- Dependencies / build output ---
node_modules/
dist/
build/
.next/
.turbo/
coverage/
*.tsbuildinfo

# --- Local data: database volumes, uploads, backups never enter git ---
pgdata/
uploads/
backups/
*.dump
*.sql.gz

# --- Logs / OS / editor ---
*.log
logs/
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- Claude Code: shared memory is tracked, personal overrides are not ---
.claude/settings.local.json
.impeccable/

# --- Code map: the three shared outputs are tracked; the rest is per-machine cache
# and files holding absolute local paths. See .claude/rules/agent-context.md.
graphify-out/*
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.json
!graphify-out/graph.html
