{
  "name": "@wms/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --conditions=wms-source src/server.ts",
    "start": "node dist/server.js",
    "worker": "tsx --conditions=wms-source src/worker.ts",
    "create-admin": "tsx --conditions=wms-source src/cli/create-admin.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/swagger": "9.9.3",
    "@wms/config": "workspace:*",
    "@wms/contracts": "workspace:*",
    "@wms/db": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15"
  }
}
